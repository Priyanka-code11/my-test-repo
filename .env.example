# Azure Speech Services Configuration
# Get these values from Azure Portal > Speech Service > Keys and Endpoint

# Your Azure Speech Service subscription key
AZURE_SPEECH_KEY=your_azure_speech_service_key_here

# Your Azure Speech Service region (e.g., eastus, westus2, northeurope)
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Language for speech recognition (default: en-US)
# AZURE_SPEECH_LANGUAGE=en-US

# Example values (replace with your actual values):
# AZURE_SPEECH_KEY=1234567890abcdef1234567890abcdef
# AZURE_SPEECH_REGION=eastus